// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  profile             Profile?
  templateUsage       TemplateUsage[]
  createdPrompts      Prompt[]
  templateGenerations TemplateGeneration[]
  clients             Client[]
}

model Profile {
  id          String  @id @default(cuid())
  userId      String  @unique
  phoneNumber String?
  address     String?
  city        String?
  country     String?
  postalCode  String?

  // Company details
  companyName     String?
  companyWebsite  String?
  companyIndustry String?
  jobTitle        String?
  companySize     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TemplateUsage {
  id     String  @id @default(cuid())
  userId String? // Optional - can track anonymous users too

  // Core Template Data
  templateType String // Professional, Promotional, etc.
  templateId   String // Template index (0-8)

  // URL Data
  urlCount Int // Number of URLs processed (1 or multiple)

  // User Context (from profile if available)
  userIndustry    String? // User's company industry
  userCompanySize String? // Company size segment
  userCountry     String? // Geographic segment

  // Success/Failure
  wasSuccessful Boolean // Did the generation succeed

  // Timestamp
  createdAt DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([templateType])
  @@index([templateId])
  @@index([createdAt])
  @@index([userIndustry])
  @@index([userCompanySize])
  @@index([wasSuccessful])
}

// Prompt Management Models
model Prompt {
  id          String  @id @default(cuid())
  name        String // "Professional Email Template"
  description String? // Brief description of template
  color       String  @default("#6366f1") // Color for template selection boxes

  // Core prompt content
  systemPrompt String @db.Text
  userPrompt   String @db.Text

  // AI Configuration
  designEngine DesignEngine @default(CLAUDE) // CLAUDE or GPT4O

  // Template Type
  templateType TemplateType @default(SINGLE_PRODUCT) // SINGLE_PRODUCT or MULTI_PRODUCT

  // Versioning & Management
  version   String       @default("1.0.0")
  status    PromptStatus @default(DRAFT) // DRAFT, ACTIVE, ARCHIVED
  isDefault Boolean      @default(false)

  // Metadata
  createdBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastTestedAt DateTime?
  testResults  Json? // Store test results and metrics

  // Usage Analytics
  usageCount  Int    @default(0)
  successRate Float? // Success rate from tests

  // Relations
  creator             User                 @relation(fields: [createdBy], references: [id])
  templateGenerations TemplateGeneration[]

  @@index([status])
  @@index([createdBy])
  @@index([isDefault])
}

model TemplateGeneration {
  id       String  @id @default(cuid())
  promptId String
  userId   String?

  // Input data
  inputUrl    String
  productInfo Json // Scraped product info

  // Output data  
  generatedHtml String  @db.Text
  subject       String?

  // Performance metrics
  generationTime Int // milliseconds
  wasSuccessful  Boolean
  errorMessage   String?

  createdAt DateTime @default(now())

  // Relations
  prompt Prompt @relation(fields: [promptId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([promptId])
  @@index([userId])
  @@index([createdAt])
}

model Country {
  code      String   @id
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientConfigs   ClientCountryConfig[]
  campaignTargets CampaignCountry[]
}

model Client {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  industry    String?
  website     String?
  notes       String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  integrations   ClientIntegration[]
  countryConfigs ClientCountryConfig[]
  campaigns      Campaign[]
  productSources ProductSource[]
  products       Product[]
  productSyncRuns ProductSyncRun[]
  campaignPlans  CampaignPlan[]
  performanceReports ProductPerformanceReport[]
  autopilotConfig     AutopilotConfig?
  autopilotSlots      AutopilotSlot[]
  autopilotCandidates AutopilotCandidate[]
  competitorSignals   CompetitorSignal[]
  autopilotRuns       AutopilotRun[]
  priceTests          PriceTest[]

  @@index([userId])
  @@index([isArchived])
}

model ClientIntegration {
  id                   String              @id @default(cuid())
  clientId             String
  provider             IntegrationProvider
  status               IntegrationStatus   @default(PENDING)
  encryptedCredentials String?
  metadata             Json?
  lastSyncedAt         DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, provider])
}

model ClientCountryConfig {
  id              String    @id @default(cuid())
  clientId        String
  countryCode     String
  isActive        Boolean   @default(false)
  mailingListId   String?
  mailingListName String?
  senderEmail     String? // Sender email for this country (must match SqualoMail)
  senderName      String? // Sender name for this country
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryCode], references: [code], onDelete: Restrict)

  @@unique([clientId, countryCode])
  @@index([countryCode])
}

model Campaign {
  id          String         @id @default(cuid())
  clientId    String
  name        String
  description String?
  status      CampaignStatus @default(DRAFT)
  externalId  String?
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  countryTargets CampaignCountry[]

  subject    String? @db.Text
  preheader  String? @db.Text
  senderName String?
  utmMedium  String?

  productUrl      String? @db.Text
  productNickname String?
  productInfoJson String? @db.LongText
  countryResultsJson String? @db.LongText
  templateId      String?
}

model CampaignCountry {
  id            String   @id @default(cuid())
  campaignId    String
  countryCode   String
  mailingListId   String?
  mailingListName String?
  externalId      String? // SqualoMail newsletter ID (set AFTER push)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Prepared newsletter data (stored at creation, consumed by cron)
  preparedHtml      String? @db.LongText
  preparedSubject   String? @db.Text
  preparedPreheader String? @db.Text
  preparedFromEmail String?
  preparedFromName  String?
  preparedName      String?
  isPushed          Boolean @default(false)
  /// SqualoMail results for this country's newsletter (refreshed until ~3 days after sending).
  statsSent         Int?
  statsOpens        Int?
  statsClicks       Int?
  statsFetchedAt    DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  country  Country  @relation(fields: [countryCode], references: [code], onDelete: Restrict)

  @@unique([campaignId, countryCode, mailingListId])
  @@index([countryCode])
}

model ProductSource {
  id           String   @id @default(cuid())
  clientId     String
  name         String?
  url          String   @db.Text
  countryCode  String?
  crawlDepth   Int      @default(1)
  isEnabled    Boolean  @default(true)
  config       Json?
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client   Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  syncRuns ProductSyncRun[]
  listings ProductListing[]

  @@index([clientId])
  @@index([countryCode])
  @@index([isEnabled])
}

model Product {
  id              String        @id @default(cuid())
  clientId        String
  externalKey     String?
  title           String
  normalizedTitle String
  groupKey        String?
  category        String?
  description     String?       @db.Text
  canonicalUrl    String?       @db.Text
  bestImageUrl    String?       @db.Text
  status          ProductStatus @default(ACTIVE)
  metadata        Json?
  firstSeenAt     DateTime      @default(now())
  lastSeenAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  client    Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  listings  ProductListing[]
  images    ProductImage[]
  planItems CampaignPlanItem[]

  @@unique([clientId, externalKey])
  @@index([clientId])
  @@index([status])
  @@index([normalizedTitle])
  @@index([clientId, groupKey])
  @@index([clientId, category])
}

model ProductListing {
  id           String              @id @default(cuid())
  clientId     String
  productId    String
  sourceId     String?
  countryCode  String?
  url          String              @db.Text
  urlHash      String
  slug         String?
  title        String?
  priceRaw     String?
  regularPrice String?
  salePrice    String?
  currency     String?
  availability ProductAvailability @default(UNKNOWN)
  metadata     Json?
  scrapedAt    DateTime            @default(now())
  lastSeenAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  source  ProductSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([clientId, urlHash])
  @@index([clientId])
  @@index([productId])
  @@index([sourceId])
  @@index([countryCode])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  url        String   @db.Text
  urlHash    String
  rank       Int      @default(0)
  isSelected Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, urlHash])
  @@index([productId])
}

model ProductSyncRun {
  id              String            @id @default(cuid())
  clientId        String
  sourceId        String?
  status          ProductSyncStatus @default(RUNNING)
  startedAt       DateTime          @default(now())
  finishedAt      DateTime?
  discoveredCount Int               @default(0)
  createdCount    Int               @default(0)
  updatedCount    Int               @default(0)
  missingCount    Int               @default(0)
  failedCount     Int               @default(0)
  errorMessage    String?           @db.Text
  log             Json?

  client Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  source ProductSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  events ProductSyncEvent[]

  @@index([clientId])
  @@index([sourceId])
  @@index([status])
  @@index([startedAt])
}

model ProductSyncEvent {
  id        String               @id @default(cuid())
  runId     String
  type      ProductSyncEventType
  productId String?
  listingId String?
  url       String?              @db.Text
  message   String?              @db.Text
  createdAt DateTime             @default(now())

  run ProductSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([type])
}

model CampaignPlan {
  id          String             @id @default(cuid())
  clientId    String
  name        String
  month       Int
  year        Int
  mode        CampaignPlanMode   @default(MANUAL)
  status      CampaignPlanStatus @default(DRAFT)
  strategy    Json?
  approvedAt  DateTime?
  /// Bumped on every write to the plan's items (planner PUT, Autopilot), so a
  /// stale planner tab can't silently overwrite newer picks.
  revision    Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  client Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items  CampaignPlanItem[]

  @@index([clientId])
  @@index([year, month])
  @@index([status])
}

/**
 * One imported monthly sales report (xlsx) per client+month — re-importing the
 * same month replaces the previous upload's entries.
 */
model ProductPerformanceReport {
  id           String   @id @default(cuid())
  clientId     String
  year         Int
  month        Int // 1-12
  fileName     String?
  rowCount     Int      @default(0)
  matchedCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client  Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  entries ProductPerformanceEntry[]

  @@unique([clientId, year, month])
  @@index([clientId])
}

/**
 * One product row from an imported report. `campaignName` is the raw sheet
 * value (the shop's product codename); `groupKey` is the matched Templaito
 * product group key (null = not in the catalog / awaiting manual link).
 */
model ProductPerformanceEntry {
  id             String   @id @default(cuid())
  reportId       String
  clientId       String
  year           Int
  month          Int
  campaignName   String
  groupKey       String?
  orders         Int      @default(0)
  quantity       Int      @default(0)
  revenue        Float    @default(0)
  uniqueProducts Int      @default(0)
  profit         Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  report ProductPerformanceReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, campaignName])
  @@index([clientId, groupKey])
  @@index([clientId, year, month])
}

model CampaignPlanItem {
  id               String                 @id @default(cuid())
  planId           String
  productId        String?
  campaignId       String?
  type             CampaignPlanItemType   @default(TEST)
  status           CampaignPlanItemStatus @default(PLANNED)
  position         Int                    @default(0)
  sendDate         DateTime?
  countryCodes     Json?
  templateId       String?
  groupKey         String?
  subject          String?                @db.Text
  preheader        String?                @db.Text
  senderName       String?
  mailingListOverrides Json?
  selectedImageUrl String?                @db.Text
  priceOverride    String?
  notes            String?                @db.Text
  errorMessage     String?                @db.Text
  productSnapshot  Json?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  plan    CampaignPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  product Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([planId])
  @@index([productId])
  @@index([campaignId])
}

/**
 * Per-client Autopilot settings: which buckets fill which send slots (4-week
 * rotation), the picking rules, seasons and the oadmin competitor-intel brands.
 */
model AutopilotConfig {
  id            String        @id @default(cuid())
  clientId      String        @unique
  mode          AutopilotMode @default(OFF)
  timezone      String        @default("Europe/Ljubljana")
  slotTimes     Json // ["08:00","17:00"] local
  rotation      Json // [4 weeks][7 days][slots] -> AutopilotBucket
  rotationStart DateTime // Monday (00:00 UTC of the local date) of rotation week 1
  weights       Json // { BEST_SELLER: 25, ... } percent
  rules         Json
  seasons       Json
  intel         Json // { ownBrandId, competitorBrandIds[] } (oadmin competitorBrand ids)
  defaults      Json // planner defaults: templateId, subject, preheader, senderName, mailingListOverrides
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

/**
 * One Autopilot send slot (client + local day + slot index). Holds the pick, why
 * it was made and its approval; the email itself is a regular CampaignPlanItem
 * at `sendAt` with the same groupKey.
 */
model AutopilotSlot {
  id             String             @id @default(cuid())
  clientId       String
  date           String // local YYYY-MM-DD
  slotIndex      Int
  sendAt         DateTime
  plannedBucket  AutopilotBucket
  bucket         AutopilotBucket
  state          AutopilotSlotState @default(PROPOSED)
  groupKey       String?
  pickedBy       AutopilotPickedBy  @default(AUTOPILOT)
  reason         String?            @db.Text
  signals        Json?
  alternatives   Json?
  priceOverride  String?
  priceSuggested Boolean            @default(false)
  /// Picked in SHADOW mode: no CampaignPlanItem was written for it (yet).
  shadow         Boolean            @default(false)
  autoApproved   Boolean            @default(false)
  approvedAt     DateTime?
  approvedById   String?
  lockedAt       DateTime?
  events         Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, date, slotIndex])
  @@index([clientId, sendAt])
}

/** Nightly snapshot of each bucket's ranked candidates (replaced per client). */
model AutopilotCandidate {
  id         String          @id @default(cuid())
  clientId   String
  computedAt DateTime
  bucket     AutopilotBucket
  groupKey   String
  baseKey    String
  score      Float
  signals    Json

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, bucket, score])
}

/** Latest oadmin competitor-intel row per brand product, matched to this client's catalog. */
model CompetitorSignal {
  id                String    @id @default(cuid())
  clientId          String
  brandId           String
  brandName         String
  isOwnBrand        Boolean   @default(false)
  productKey        String
  token             String?
  name              String?   @db.Text
  baseKey           String?
  groupKey          String?
  activeAds         Int       @default(0)
  totalAds          Int       @default(0)
  newAds7d          Int       @default(0)
  newAds30d         Int       @default(0)
  reach             Int       @default(0)
  reach7d           Int       @default(0)
  score             Float     @default(0)
  listedSince       DateTime?
  listedSinceSource String?
  firstAdAt         DateTime?
  lastAdAt          DateTime?
  imageUrl          String?   @db.Text
  fetchedAt         DateTime

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, brandId, productKey])
  @@index([clientId, baseKey])
}

/**
 * One Autopilot price test: a best seller's repeat send at a slightly higher
 * price, judged by margin-weighted clicks against its earlier sends (and later
 * by the monthly sales report).
 */
model PriceTest {
  id         String          @id @default(cuid())
  clientId   String
  groupKey   String
  basePrice  String
  testPrice  String
  status     PriceTestStatus @default(RUNNING)
  slotId     String?
  campaignId String?
  sendAt     DateTime
  baseline   Json?
  result     Json?
  decision   String?         @db.Text
  decidedAt  DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, groupKey])
  @@index([status])
}

model AutopilotRun {
  id         String    @id @default(cuid())
  clientId   String?
  kind       String // NIGHTLY | MANUAL
  status     String // RUNNING | SUCCESS | PARTIAL | FAILED
  stats      Json?
  error      String?   @db.Text
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, startedAt])
}

enum DesignEngine {
  CLAUDE
  GPT4O
}

enum PromptStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum IntegrationProvider {
  SQUALOMAIL
  KLAVIYO
  MAILCHIMP
}

enum IntegrationStatus {
  PENDING
  CONNECTED
  ERROR
  DISCONNECTED
}

enum CampaignStatus {
  DRAFT
  READY
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum TemplateType {
  SINGLE_PRODUCT
  MULTI_PRODUCT
}

enum ProductStatus {
  ACTIVE
  POSSIBLY_UNAVAILABLE
  ARCHIVED
}

enum ProductAvailability {
  IN_STOCK
  OUT_OF_STOCK
  UNKNOWN
}

enum ProductSyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum ProductSyncEventType {
  CREATED
  UPDATED
  MISSING
  FAILED
  ARCHIVED
  RESTORED
}

enum CampaignPlanMode {
  MANUAL
  ASSISTED
}

enum CampaignPlanStatus {
  DRAFT
  APPROVED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum CampaignPlanItemType {
  WINNER
  TEST
  MANUAL
}

enum CampaignPlanItemStatus {
  PLANNED
  QUEUED
  GENERATING
  SCHEDULED
  FAILED
}

enum AutopilotMode {
  OFF
  SHADOW
  ON
}

enum AutopilotBucket {
  BEST_SELLER
  NEW_PRODUCT
  FB_WINNER
  SEASONAL
  DISCOVERY
}

enum AutopilotSlotState {
  PROPOSED
  APPROVED
  SKIPPED
  EMPTY
  LOCKED
}

enum AutopilotPickedBy {
  AUTOPILOT
  USER
}

enum PriceTestStatus {
  RUNNING
  KEPT
  REVERTED
  CANCELLED
}
